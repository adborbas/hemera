default_platform(:ios)

XCCONFIG = "Config/Shared.xcconfig".freeze
BETA_GROUP = "Testers (all builds)".freeze # internal group set to auto-receive all builds
APP_IDENTIFIER = "com.adborbas.hemera.app".freeze

platform :ios do
  # ---------------------------------------------------------------------------
  # 1. Cut a new release
  #    Branch release/<version> from main and pin <version> on it. The version
  #    is a release counter derived from the tags — the next release after v2.0
  #    is 3.0 — so nothing has to be decided or bumped ahead of time. Pass
  #    version: explicitly for a hotfix (2.0 -> 2.1).
  #    Usage: bundle exec fastlane cut_release
  # ---------------------------------------------------------------------------
  desc "Cut a release branch for the next version"
  lane :cut_release do |options|
    version = options[:version]
    version = nil if version.to_s.strip.empty?

    ensure_git_status_clean
    sh("git", "fetch", "origin", "main", "--tags")

    version ||= next_release_version
    branch = "release/#{version}"

    # Skipped when already done, so the release train can be re-run after a
    # later stage fails without tripping over the branch it already cut.
    if remote_branch_exists?(branch)
      UI.important("#{branch} already exists on origin — leaving it untouched.")
    else
      # Pin <version> on the branch. main holds whatever was released last, so
      # this commits the new number unless the two already agree.
      sh("git", "checkout", "-B", branch, "origin/main")
      if get_xcconfig_value(key: "MARKETING_VERSION") != version
        set_xcconfig_value(key: "MARKETING_VERSION", value: version)
        git_commit(path: XCCONFIG, message: "Prepare release #{version}")
      end
      push_to_git_remote(local_branch: branch, remote_branch: branch, force: false)
    end

    github_output("version", version)
    UI.success("Cut #{branch} at #{version}. main picks the version up when the release is published and back-merged.")
  end

  # ---------------------------------------------------------------------------
  # 2. Upload a release build to TestFlight
  #    Signs via match, bumps the build number, archives, uploads.
  #    Usage: bundle exec fastlane beta
  # ---------------------------------------------------------------------------
  desc "Build a signed release and upload it to TestFlight"
  lane :beta do
    # On CI there is no interactive login keychain, so match can't set the key
    # partition list on the runner's login keychain (no password), leaving
    # codesign blocked on a UI authorization prompt that never comes (the job
    # then hangs until the timeout). setup_ci creates a dedicated temporary
    # keychain with a known password that match imports into and codesign uses
    # non-interactively. It is a no-op when running locally.
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: true,
      in_house: false
    )

    # Fail fast (before the slow archive) if MARKETING_VERSION is already
    # released: its TestFlight train is closed, so the upload would be rejected.
    # Bumping the marketing version is a once-per-release decision — run
    # `fastlane cut_release version:<next>` instead.
    ensure_open_version_train!

    match(
      type: "appstore",
      api_key: api_key,
      readonly: true
    )

    # Unique build number per upload: highest TestFlight build for this version + 1.
    next_build = latest_testflight_build_number(
      api_key: api_key,
      initial_build_number: 0
    ) + 1
    set_xcconfig_value(key: "CURRENT_PROJECT_VERSION", value: next_build.to_s)
    github_output("build_number", next_build)

    # The project uses automatic signing for local development, but on CI there's
    # no Apple account to resolve a profile, so the archive must use manual
    # signing with the match-installed distribution profile. Scoped to the
    # Release configuration so Debug/local automatic signing is untouched.
    profile_name = ENV.fetch("sigh_com.adborbas.hemera.app_appstore_profile-name")
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Hemera.xcodeproj",
      targets: ["Hemera"],
      build_configurations: ["Release"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    build_app(
      project: "Hemera.xcodeproj",
      scheme: "Hemera",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          # match sets this env var to the exact profile name it installed.
          "com.adborbas.hemera.app" => ENV["sigh_com.adborbas.hemera.app_appstore_profile-name"]
        }
      }
    )

    # Upload and return immediately — do NOT wait for App Store Connect to
    # finish processing. Waiting is a well-known source of CI hangs (pilot polls
    # the oldest processing build, not the one just uploaded), and it's the only
    # reason the job needs to wait at all. Distribution to internal testers is
    # decoupled: the "Testers" group has access to all builds, so every build is
    # delivered automatically once Apple finishes processing it — no in-lane
    # group assignment (which would force the wait) required.
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )

    UI.success("Uploaded build #{next_build} to TestFlight. It will reach the '#{BETA_GROUP}' group once App Store Connect finishes processing it.")
  end

  # ---------------------------------------------------------------------------
  # 3. Publish a release
  #    Tag the release branch, create a GitHub release, merge back to main.
  #    Usage: bundle exec fastlane publish version:1.3.0
  # ---------------------------------------------------------------------------
  desc "Tag, create a GitHub release, and merge the release branch back to main"
  lane :publish do |options|
    version = options[:version] or UI.user_error!("Missing `version:` (e.g. version:1.3.0)")
    branch = "release/#{version}"
    tag = "v#{version}"

    ensure_git_status_clean
    sh("git", "fetch", "origin", branch, "main")
    sh("git", "checkout", branch)
    sh("git", "reset", "--hard", "origin/#{branch}")

    if remote_tag_exists?(tag)
      UI.important("#{tag} is already tagged — skipping the tag and GitHub release.")
    else
      add_git_tag(tag: tag)
      push_git_tags(tag: tag)
      sh("gh", "release", "create", tag, "--title", version, "--notes", "Release #{version}")
    end

    # Open a PR to merge the release branch back into main — but only if the
    # branch has commits main doesn't already have (e.g. fixes made during
    # review). With the version pinned by branching rather than a commit, a clean
    # release often has nothing to merge back. Merging the PR (and deleting the
    # branch) is a manual step so it respects branch protection.
    behind = sh("git", "rev-list", "--count", "origin/main..origin/#{branch}").strip.to_i
    if behind.zero?
      UI.success("Published #{tag}. No release-branch changes to merge back to main.")
    else
      sh(
        "gh", "pr", "create",
        "--base", "main",
        "--head", branch,
        "--title", "Merge #{branch} back to main",
        "--body", "Back-merge of the shipped #{tag} release into main."
      )
      # Admin-merged like the version bump: these commits already shipped, and
      # requiring a review here would stall the unattended publish.
      sh("gh", "pr", "merge", branch, "--merge", "--admin")
      UI.success("Published #{tag} and merged #{branch} back into main.")
    end

    # The tag now marks the shipped commit, so the branch has done its job.
    # Deleting it is also what makes publish_if_live a no-op on later runs.
    # Merging the PR may already have deleted it: the repo deletes head
    # branches on merge.
    if remote_branch_exists?(branch)
      sh("git", "push", "origin", "--delete", branch)
    end
  end

  # ---------------------------------------------------------------------------
  # 4. Prepare an App Store version for review
  #    Creates/updates the App Store version, attaches the latest processed
  #    build, sets the release notes (from fastlane/metadata), and marks it for
  #    automatic release — everything except the final Submit, which stays a
  #    manual click in App Store Connect.
  #    Usage: bundle exec fastlane prepare_release [version:1.4.0] [build:12]
  #    version defaults to the branch MARKETING_VERSION; build to the latest.
  # ---------------------------------------------------------------------------
  desc "Prepare an App Store version for review (does not submit)"
  lane :prepare_release do |options|
    version = options[:version]
    version = nil if version.to_s.strip.empty?
    version ||= get_xcconfig_value(key: "MARKETING_VERSION")

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: true,
      in_house: false
    )

    # Attach a specific build if given, otherwise the latest build already
    # uploaded to TestFlight for this version.
    build_number = options[:build]
    build_number = nil if build_number.to_s.strip.empty?
    # initial_build_number is what the action returns when the version has no
    # build at all; 0 makes that case recognisable instead of a plausible "1"
    # that the wait below would then poll until it times out.
    build_number ||= latest_testflight_build_number(
      api_key: api_key,
      version: version,
      initial_build_number: 0
    )
    if build_number.to_i.zero?
      UI.user_error!("No TestFlight build found for #{version} — run the beta lane first.")
    end

    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("Could not find app #{APP_IDENTIFIER} on App Store Connect") if app.nil?

    # Wait before deliver, so a build that will never arrive fails the lane
    # before any metadata is written.
    build = wait_for_processed_build!(app: app, version: version, build_number: build_number)

    deliver(
      api_key: api_key,
      app_version: version,
      skip_binary_upload: true,   # the build is uploaded by the beta lane
      skip_screenshots: true,     # screenshots are managed manually in ASC
      skip_metadata: false,       # push release_notes from fastlane/metadata
      automatic_release: true,    # go live automatically once approved
      submit_for_review: false,   # prepare only — submit stays a manual step
      run_precheck_before_submit: false,
      force: true                 # no interactive HTML preview on CI
    )

    # deliver only attaches a build on its way to submitting for review, which
    # this lane deliberately does not do — so without this the version is left
    # with no build at all, and passing `build_number:` to deliver would only
    # have suppressed a binary upload that skip_binary_upload already blocks.
    asc_version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    UI.user_error!("No editable App Store version to attach build #{build_number} to") if asc_version.nil?
    asc_version.select_build(build_id: build.id)

    UI.success("Prepared App Store version #{version} with build #{build_number} attached. Submit it in App Store Connect when ready.")
  end

  # ---------------------------------------------------------------------------
  # 5. Publish automatically once Apple releases the version
  #    Driven by a schedule: publishes only when the live App Store version
  #    still has a release branch, which `publish` deletes when it is done.
  #    Usage: bundle exec fastlane publish_if_live
  # ---------------------------------------------------------------------------
  desc "Publish the pending release if App Store Connect reports it live"
  lane :publish_if_live do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: true,
      in_house: false
    )

    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("Could not find app #{APP_IDENTIFIER} on App Store Connect") if app.nil?

    live = app.get_live_app_store_version
    if live.nil?
      UI.important("Nothing is live on the App Store yet.")
      next
    end

    version = live.version_string
    sh("git", "fetch", "origin")
    unless remote_branch_exists?("release/#{version}")
      UI.message("#{version} is live and release/#{version} is already retired — nothing to do.")
      next
    end

    UI.important("#{version} is live on the App Store — publishing it.")
    publish(version: version)
  end
end

# Set a KEY = VALUE line in Config/Shared.xcconfig in place.
def set_xcconfig_value(key:, value:)
  path = File.expand_path("../#{XCCONFIG}", __dir__)
  contents = File.read(path)
  updated = contents.gsub(/^#{Regexp.escape(key)}\s*=.*$/, "#{key} = #{value}")
  UI.user_error!("`#{key}` not found in #{XCCONFIG}") if updated == contents
  File.write(path, updated)
  UI.message("Set #{key} = #{value} in #{XCCONFIG}")
end

# The next release number: one past the highest release ever tagged. Hotfixes
# move the second component (2.0 -> 2.1) and are cut by passing version:
# explicitly, so they never influence what the next release is called.
def next_release_version
  tags = sh("git", "tag", "--list", "v*", log: false).split("\n")
  highest = tags.filter_map { |tag| tag.strip.delete_prefix("v").split(".").first&.to_i }.max
  UI.user_error!("No v* tags found to count releases from") if highest.nil?
  "#{highest + 1}.0"
end

# Read a KEY's value from Config/Shared.xcconfig.
def get_xcconfig_value(key:)
  path = File.expand_path("../#{XCCONFIG}", __dir__)
  match = File.read(path).match(/^#{Regexp.escape(key)}\s*=\s*(.+)$/)
  UI.user_error!("`#{key}` not found in #{XCCONFIG}") if match.nil?
  match[1].strip
end

# Fail if MARKETING_VERSION is already released on the App Store — its
# TestFlight train is closed for new builds. Requires that spaceship is already
# authenticated (app_store_connect_api_key sets its token by default).
def ensure_open_version_train!
  marketing_version = get_xcconfig_value(key: "MARKETING_VERSION")
  app = Spaceship::ConnectAPI::App.find("com.adborbas.hemera.app")
  UI.user_error!("Could not find app com.adborbas.hemera.app on App Store Connect") if app.nil?

  live = app.get_live_app_store_version
  return if live.nil? # nothing released yet — any version is open

  if Gem::Version.new(marketing_version) <= Gem::Version.new(live.version_string)
    UI.user_error!(
      "MARKETING_VERSION #{marketing_version} is already released (live: #{live.version_string}). " \
      "Its TestFlight train is closed for new builds. " \
      "Run `fastlane cut_release version:<next>` to bump the marketing version first."
    )
  end
end

# True if <branch> exists on origin. `git ls-remote` exits 0 with no output
# when nothing matches, so the output is what tells the two apart.
def remote_branch_exists?(branch)
  !sh("git", "ls-remote", "--heads", "origin", branch, log: false).strip.empty?
end

# True if <tag> exists on origin.
def remote_tag_exists?(tag)
  !sh("git", "ls-remote", "--tags", "origin", tag, log: false).strip.empty?
end

# Publish a value for later jobs in the same GitHub Actions workflow. A no-op
# everywhere else, so the lanes stay runnable locally.
def github_output(name, value)
  path = ENV["GITHUB_OUTPUT"]
  return if path.to_s.empty?
  File.open(path, "a") { |file| file.puts("#{name}=#{value}") }
end

# Block until <build_number> for <version> is processed, and return it.
# Polls that exact build on purpose: pilot's own wait watches the oldest
# processing build instead, which is the hang the beta lane refuses to risk.
def wait_for_processed_build!(app:, version:, build_number:, timeout: 2700, interval: 30)
  states = Spaceship::ConnectAPI::Build::ProcessingState
  deadline = Time.now + timeout

  loop do
    build = Spaceship::ConnectAPI::Build.all(
      app_id: app.id,
      version: version,
      build_number: build_number.to_s,
      platform: Spaceship::ConnectAPI::Platform::IOS
    ).first
    state = build&.processing_state

    return build if state == states::VALID

    if [states::FAILED, states::INVALID].include?(state)
      UI.user_error!("Build #{build_number} for #{version} finished processing as #{state}.")
    end

    if Time.now > deadline
      UI.user_error!("Timed out after #{timeout}s waiting for build #{build_number} (#{version}) to process.")
    end

    UI.message("Build #{build_number} for #{version} is #{state || 'not visible yet'} — checking again in #{interval}s.")
    sleep(interval)
  end
end
